<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="6dp">

    <TextView
        android:id="@+id/tvNamaItem"
        style="@style/TextAppearance.KopiDanNyemil.BodyLarge"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/tvKuantitasItem"
        style="@style/TextAppearance.KopiDanNyemil.BodyMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:textColor="@color/text_secondary" />

    <TextView
        android:id="@+id/tvSubtotalItem"
        style="@style/TextAppearance.KopiDanNyemil.TitleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/primary_coffee" />
</LinearLayout>
